rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidDevice(deviceId) {
      return deviceId is string && deviceId.size() > 3;
    }

    // Devices Collection
    match /devices/{deviceId} {
      // Allows pairing handshake & presence update
      allow read: if true;
      allow create, update: if isValidDevice(deviceId);
      allow delete: if false; // prevent accidental deletion
    }

    // Commands Collection (SMS dispatch queue)
    match /commands/{deviceId}/messages/{commandId} {
      // Only allow reading commands for the specific target device
      allow read: if isValidDevice(deviceId);
      
      // Allow creating pending SMS commands (Web Dashboard)
      allow create: if isValidDevice(deviceId) 
        && request.resource.data.recipient is string
        && request.resource.data.message is string
        && request.resource.data.status == "pending";

      // Allow updating status (Android device updates to 'sent' or 'failed')
      allow update: if isValidDevice(deviceId) 
        && request.resource.data.status in ["sent", "failed", "pending"];

      allow delete: if false;
    }
  }
}
